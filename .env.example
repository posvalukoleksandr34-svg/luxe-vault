# ---------------------------------------------------------------------------
# Supabase  —  Project Settings → API
# ---------------------------------------------------------------------------
# Safe to expose to the browser; every query it makes is constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# SERVER ONLY. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_ and never
# import into a client component. Used by the admin console and webhooks.
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# ---------------------------------------------------------------------------
# Canonical site origin — used to build Supabase auth email links.
# Without this, confirmation emails point at the project's Site URL, which in
# a fresh Supabase project is still http://localhost:3000.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://luxe-vault-hlb1.vercel.app

# ---------------------------------------------------------------------------
# Transactional email (Resend) — https://resend.com
#
# Only the API key is configuration. The SENDER is pinned in code as
#   Luxe Vault <orders@luxe-vault.store>          (lib/server/resend.ts)
# because Resend rejects any `from` on an unverified domain — a wrong value
# there breaks every send silently rather than degrading, which makes it safer
# as a reviewed constant than as an environment variable.
#
# Without RESEND_API_KEY the app still works: orders are still created and
# support tickets still stored; only the emails are skipped.
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# Delivery mode for every transactional email (lib/server/resend.ts).
#   test — nothing reaches a customer: each email is logged with a masked
#          recipient, or — with EMAIL_TEST_RECIPIENT set — redirected there
#          with "[TEST → a***@example.com]" in the subject.
#   live — sent to the real recipient.
# Unset: live when RESEND_API_KEY is set, test when it is not. Review every
# template in every language at /api/admin/email-preview (admin only).
# EMAIL_DELIVERY=test
# EMAIL_TEST_RECIPIENT=

# Where support enquiries are delivered, and the Reply-To on customer emails.
# This is an INBOX, so it need not be on the verified sending domain — but it
# does have to be a mailbox somebody actually reads.
SUPPORT_INBOX_EMAIL=support@luxe-vault.store

# ---------------------------------------------------------------------------
# Private admin console (/admin)
# ---------------------------------------------------------------------------
# BOTH ARE REQUIRED. There are no defaults: the console answers 503 rather than
# falling back to a password committed in the source, which is what it used to
# do. Set them in Vercel → Settings → Environment Variables before deploying.
#
# Write the values bare, with no surrounding quotes.
#
# ADMIN_SESSION_SECRET signs the admin session cookie. Any long random string
# works — `openssl rand -hex 32`. Changing EITHER variable invalidates every
# existing admin session, which is what makes rotating the password after a
# suspected leak actually effective.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Crypto checkout (NOWPayments) — optional; the option hides itself if unset
# ---------------------------------------------------------------------------
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_IPN_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Card checkout (Stripe) — required for the "Карта онлайн" method
# ---------------------------------------------------------------------------
# Server-side only. Never expose this.
STRIPE_SECRET_KEY=

# Public by design. Required since the move from hosted Checkout to an embedded
# PaymentElement: Stripe.js runs in the browser and authenticates with this key
# to render the card form and confirm the payment. It can do nothing the server
# has not already authorised.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From `stripe listen --forward-to localhost:3000/api/payments/stripe/webhook`
# in development, or the endpoint's signing secret in the Stripe dashboard.
#
# The endpoint must be subscribed to payment_intent.succeeded,
# payment_intent.processing, payment_intent.payment_failed,
# payment_intent.canceled and charge.refunded (the last keeps orders in step
# with refunds made in the Stripe dashboard). It previously listened for
# checkout.session.*, which no longer fires now that there is no hosted
# Checkout Session. Apply migration 0027 so each event is processed once.
#
# Without this secret the webhook returns 503 and NO order is ever marked paid:
# neither the browser reaching /success nor confirmPayment() resolving is
# treated as proof of payment.
STRIPE_WEBHOOK_SECRET=

# Optional. Which currencies a card may be CHARGED in, comma-separated. Prices
# are stored in CHF and converted with EXCHANGE_RATES (lib/currency.ts); a
# customer who picks EUR or USD is charged in it. Unset: CHF, EUR and USD are
# all accepted. List only the ones enabled on the Stripe account — a currency
# left out (or one Stripe refuses) is charged in CHF instead, and the payment
# step tells the customer so before they pay. CHF is always accepted.
# STRIPE_PRESENTMENT_CURRENCIES=CHF,EUR,USD

# ---------------------------------------------------------------------------
# Address autocomplete — optional
# ---------------------------------------------------------------------------
# Unset: falls back to Photon (Komoot's OSM geocoder). Free, no key, and it
# already returns structured postcode + city, which is what fills the fields.
# Set: switches to Google Places Autocomplete, which is better for
# apartment-level addresses but is billed per keystroke-batch and returns no
# postcode without a second (also billed) Place Details call.
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# AI Stylist copy (Google Gemini) — optional
# ---------------------------------------------------------------------------
# Only writes the one or two sentences under a look. The products themselves
# are chosen by the deterministic engine (lib/server/stylist/engine.ts) and the
# model never picks them. Unset: the sentence is composed from the look's own
# fits and colours, and the stylist works exactly the same otherwise.
#
# SERVER ONLY — from https://aistudio.google.com/apikey. Never NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash. Do not set gemini-2.0-flash: it is
# retired and answers 404, which this feature would absorb silently.
# GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Scheduled sweep (/api/cron/sweep)
# ---------------------------------------------------------------------------
# Shared secret for the job that sends unpaid-order reminders and
# back-in-stock alerts. Called as:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://luxe-vault.store/api/cron/sweep
#
# WITHOUT THIS SET THE SWEEP IS DISABLED and answers 503. That is deliberate:
# an unauthenticated version is a button anyone on the internet can press to
# email your customers. Generate one with: openssl rand -hex 32
CRON_SECRET=

# Abandoned-cart reminders: how long a checkout must sit idle before its one
# recovery email (minutes; 15 – 10080, default 120). Sent by
# /api/cron/abandoned-carts — hourly via .github/workflows/abandoned-cart-reminders.yml
# — and by the nightly sweep as a fallback.
ABANDONED_CART_DELAY_MINUTES=120

# ---------------------------------------------------------------------------
# Telegram operations bot (lib/telegram.ts)
# ---------------------------------------------------------------------------
# New orders, confirmed payments (Stripe, NOWPayments), status changes and
# critical errors are posted to this chat. Both unset: alerts are off.
# Create the bot with @BotFather, add it to the staff group, and use the
# group's id (starts with -100). Messages never contain customer names,
# emails, phone numbers or addresses.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: route each kind of alert to its own TOPIC in a forum group.
# Enable topics in the group's settings, create one per kind, open it, and
# copy the last number of its link (t.me/c/<chat>/<THIS>). Leave any of these
# empty and that kind goes to the chat itself. A wrong number is harmless too:
# Telegram refuses it and the alert is re-sent to the main chat.
TELEGRAM_THREAD_ORDERS=
TELEGRAM_THREAD_ERRORS=
TELEGRAM_THREAD_STOCK=
TELEGRAM_THREAD_RETURNS=

# ---------------------------------------------------------------------------
# Crash alerting (lib/monitoring/alert.ts)
# ---------------------------------------------------------------------------
# Unhandled crashes — a failed render, a checkout that could not write its
# order, a payment status that could not be saved — are reported to whichever
# of these is set. Both optional and independent: with neither, alerting is
# off and crashes go to the platform logs only, which is a perfectly
# reasonable way to run a small shop.
#
# Telegram reuses TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID above; nothing extra
# is needed for it.
#
# SYSTEM_ALERT_WEBHOOK is for teams that watch Slack or Discord instead. Paste
# an incoming-webhook URL; the payload carries both `text` and `content`, so
# either service accepts it without being told which one you use.
#
#   Slack:   https://hooks.slack.com/services/T000/B000/xxxx
#   Discord: https://discord.com/api/webhooks/000/xxxx
#
# SERVER-SIDE ONLY, and deliberately not NEXT_PUBLIC_. A webhook URL in the
# browser bundle is an open pipe into your own chat for anyone who opens
# devtools; the browser posts to /api/monitoring/report instead, which is rate
# limited and holds this value server-side.
SYSTEM_ALERT_WEBHOOK=

# Bearer secret for POST /api/internal/telegram, which lets external jobs and
# monitors post into the same chat. Unset: the endpoint answers 503.
# Generate one with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ---------------------------------------------------------------- Contact page
# Optional. The support phone line shown on /contact ("По телефону"), in
# international format, and its hours as they should read. Without a number
# the card offers Telegram instead.
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_PHONE_HOURS=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (captcha on sign-in, registration and password reset)
# ---------------------------------------------------------------------------
# Get the pair at dash.cloudflare.com -> Turnstile -> Add widget (free).
# Add every hostname you serve from, INCLUDING localhost for development.
#
# Both unset: no widget is rendered and nothing is verified — the forms behave
# exactly as they did before. That is the safe default, not a bypass: with the
# secret set, a missing or replayed token is refused.
#
# Cloudflare's own testing keys, safe to paste here while developing:
#   always passes:  site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
#   always blocks:  site 2x00000000000000000000AB  secret 2x0000000000000000000000000000000AA
#   forces the interactive challenge: site 3x00000000000000000000FF
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
#
# IMPORTANT — sign-in and registration do NOT pass through this app's server:
# the browser talks to Supabase Auth directly, so SUPABASE must do the
# verifying for those two. In the Supabase dashboard:
#   Authentication -> Attack Protection -> Enable CAPTCHA protection
#   Provider: Turnstile, and paste CLOUDFLARE_TURNSTILE_SECRET_KEY there too.
# Without that step the token is sent and silently ignored — the widget would
# be decoration. Password reset (/api/auth/recovery) is our own route and is
# verified by lib/server/turnstile.ts regardless.
