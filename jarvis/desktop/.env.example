# JARVIS desktop agent. Copy to .env next to jarvis_desktop.py (Windows installer writes
# %LOCALAPPDATA%\JARVIS\desktop.env instead).

# Your JARVIS address (the same one you open in the browser).
JARVIS_URL=http://localhost
# Device token with the "computer" scope: JARVIS → Settings → Sessions and devices → "Computer".
JARVIS_DEVICE_TOKEN=
# Shown in JARVIS; default: this computer's hostname.
JARVIS_DEVICE_NAME=

# Local kill switches — what JARVIS may do on THIS computer (1 = allowed). The server still asks for
# confirmation where its policy says so; these refuse the action outright.
JARVIS_ALLOW_APPS=1
JARVIS_ALLOW_BROWSER=1
JARVIS_ALLOW_MEDIA=1
JARVIS_ALLOW_VOLUME=1
JARVIS_ALLOW_WINDOWS=1
JARVIS_ALLOW_INPUT=1
JARVIS_ALLOW_CLIPBOARD=1
JARVIS_ALLOW_SCREEN=1
# Shell commands are off by default. Enable only if you really want JARVIS to run commands here.
JARVIS_ALLOW_SHELL=0
# Optional allow-list of app names JARVIS may open, comma separated (empty = any installed app).
JARVIS_ALLOWED_APPS=
