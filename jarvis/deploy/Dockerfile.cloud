# syntax=docker/dockerfile:1.7
# Backend image for PaaS hosts (Render, Railway, Fly.io …) where the repository cannot be bind-mounted:
# config/ and skills/ are baked in. Build context = repository root:
#   docker build -f deploy/Dockerfile.cloud -t jarvis-backend:cloud .
# Same roles as backend/Dockerfile: `api` (default) and `worker`.
FROM python:3.12-slim AS deps
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app/backend
COPY backend/pyproject.toml ./
RUN python - <<'PY' > /tmp/reqs.txt
import tomllib
p = tomllib.load(open("pyproject.toml", "rb"))["project"]
deps = p["dependencies"] + p["optional-dependencies"]["local-embeddings"] + p["optional-dependencies"]["browser"]
print("\n".join(deps))
PY
RUN --mount=type=secret,id=ca,required=false \
    if [ -s /run/secrets/ca ]; then export PIP_CERT=/run/secrets/ca; fi; \
    pip install -r /tmp/reqs.txt "setuptools>=75"

FROM deps AS runtime
COPY backend/ ./
RUN pip install --no-deps --no-build-isolation -e . \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin jarvis \
    && mkdir -p /data && chown -R jarvis:jarvis /data
COPY config /app/config
COPY skills /app/skills
COPY backend/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
USER jarvis
ENV JARVIS_DATA_DIR=/data JARVIS_CONFIG_DIR=/app/config JARVIS_SKILLS_DIR=/app/skills HF_HOME=/data/models
EXPOSE 8000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["api"]
