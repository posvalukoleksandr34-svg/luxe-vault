# =====================================================================================================
# JARVIS configuration. Copy to .env (scripts/setup.sh does this and generates every secret for you).
# Everything marked [secret] must be unique per install. Never commit .env.
# =====================================================================================================

# ---- deployment -------------------------------------------------------------------------------------
# Your domain for automatic HTTPS (Let's Encrypt), e.g. jarvis.example.com. ":80" = plain HTTP locally.
JARVIS_SITE_ADDRESS=:80
# The URL you open in the browser (used for OAuth redirects, webhooks, links in notifications).
JARVIS_PUBLIC_URL=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
# Optional components: browser, sandbox, monitoring, local-ai (comma separated).
COMPOSE_PROFILES=browser,sandbox
JARVIS_BROWSER_WS_ENDPOINT=ws://browser:3000/
JARVIS_SANDBOX_URL=http://sandbox:8090

# ---- owner & locale ---------------------------------------------------------------------------------
# Leave the owner empty to create the account in the browser with the one-time setup code from
# `docker compose logs api | grep SETUP`.
JARVIS_OWNER_EMAIL=
JARVIS_OWNER_PASSWORD=
JARVIS_OWNER_NAME=
JARVIS_TIMEZONE=UTC
JARVIS_LOCALE=ru

# ---- brain ------------------------------------------------------------------------------------------
# Which model family thinks: anthropic (Claude) or openai (GPT). With openai only OPENAI_API_KEY is needed
# and Anthropic is never called (models: config/models.yaml → openai_routes).
JARVIS_LLM_PROVIDER=anthropic
# Required for real intelligence when JARVIS_LLM_PROVIDER=anthropic. Can also be entered later in
# Settings → API keys (stored encrypted).
ANTHROPIC_API_KEY=
# Hard stop for model spend per day (USD).
JARVIS_DAILY_COST_LIMIT_USD=20
# Optional private/failover model on an OpenAI-compatible server (Ollama: http://ollama:11434/v1).
JARVIS_LOCAL_LLM_BASE_URL=
# Offline demo without a model: a deterministic rule-based stand-in (for trying the pipeline only).
JARVIS_FAKE_LLM=false

# ---- memory -----------------------------------------------------------------------------------------
# local = private multilingual embeddings on CPU (downloads ~220 MB on first start); voyage | openai | none
JARVIS_EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
# The brain when JARVIS_LLM_PROVIDER=openai; otherwise optional (STT/TTS/embeddings fallback).
OPENAI_API_KEY=
# Mirror for the local embedding model download if huggingface.co is not reachable from the server.
HF_ENDPOINT=

# ---- web search -------------------------------------------------------------------------------------
# anthropic = Claude's server-side web search/fetch (no extra key; only when the brain is Claude);
# tavily | brave use their keys (needed for web search when JARVIS_LLM_PROVIDER=openai).
JARVIS_SEARCH_PROVIDER=anthropic
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---- voice ------------------------------------------------------------------------------------------
# Without keys the browser's own speech recognition/synthesis is used (Chrome).
JARVIS_STT_PROVIDER=deepgram
JARVIS_TTS_PROVIDER=elevenlabs
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
JARVIS_ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- Telegram ---------------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# polling works everywhere (no public URL needed); webhook requires HTTPS on JARVIS_PUBLIC_URL.
JARVIS_TELEGRAM_MODE=polling
# [secret] verifies webhook calls from Telegram
JARVIS_TELEGRAM_WEBHOOK_SECRET=

# ---- WhatsApp (Meta Cloud API) ----------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# [secret] any random string; enter the same value in the Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=
JARVIS_WHATSAPP_GRAPH_VERSION=v21.0

# ---- Google (Gmail, Calendar, Drive) ----------------------------------------------------------------
# OAuth client of type "Web application"; redirect URI: <JARVIS_PUBLIC_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- security ---------------------------------------------------------------------------------------
# [secret] Fernet key(s), newest first, comma separated. Empty = generated into the data volume on first
# start. Store a copy in your password manager: without it encrypted credentials cannot be recovered.
JARVIS_MASTER_KEYS=
# [secret] database password (internal network only)
POSTGRES_PASSWORD=
# [secret] shared between worker and sandbox
SANDBOX_TOKEN=
# [secret] Prometheus scrape token for /metrics
JARVIS_METRICS_TOKEN=
JARVIS_SESSION_TTL_DAYS=30
JARVIS_APPROVAL_TTL_HOURS=24

# ---- backups ----------------------------------------------------------------------------------------
# [secret] encrypts every snapshot. Lose it = lose the backups. Store it in your password manager.
RESTIC_PASSWORD=
# Local repository by default; for off-site use e.g. s3:s3.eu-central-1.amazonaws.com/bucket/jarvis or
# b2:bucket:jarvis (+ AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or B2_ACCOUNT_ID/B2_ACCOUNT_KEY).
RESTIC_REPOSITORY=/backups/restic
BACKUP_DIR=./backups
BACKUP_CRON=30 3 * * *
# Optional dead-man's switch (healthchecks.io URL) pinged after every successful backup.
BACKUP_HEALTHCHECK_URL=

# ---- monitoring (COMPOSE_PROFILES += monitoring) ----------------------------------------------------
GRAFANA_ADMIN_PASSWORD=

# ---- runtime tuning ---------------------------------------------------------------------------------
JARVIS_ENV=production
JARVIS_LOG_LEVEL=INFO
JARVIS_WORKER_CONCURRENCY=4
JARVIS_MAX_AGENT_STEPS=25
