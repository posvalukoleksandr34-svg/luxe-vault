# Voice satellite for a Raspberry Pi / spare PC with a microphone and speaker.
JARVIS_URL=https://jarvis.example.com
# Settings → Sessions and devices → "Выдать токен" (scopes: voice)
JARVIS_TOKEN=jv_dev_...
# openWakeWord model name (hey_jarvis ships with openWakeWord; CC BY-NC-SA 4.0 — personal use)
WAKE_WORD=hey_jarvis
WAKE_THRESHOLD=0.5
# Endpointing: stop recording after this much silence (ms) or at MAX_UTTERANCE_S
SILENCE_MS=800
MAX_UTTERANCE_S=15
# RMS level that counts as speech (0..32767); calibrate with --calibrate
SPEECH_RMS=500
INPUT_DEVICE=
OUTPUT_DEVICE=
